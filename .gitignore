# Build output
build/
.gradle/
.kotlin/
*.apk
*.aab

# Local machine settings & environment secrets
local.properties
.env
.env.*
*.env
.idea/
*.iml
.DS_Store
captures/
*.log
*.bak

# Downloaded by the build (see app/build.gradle.kts)
app/libs/*.aar
app/libs/*.part

# Signing keys & private certificates: never commit these
*.jks
*.keystore
*.pem
*.p12
*.key

# Optional native engine and models for RealEngineTest (see CONTRIBUTING.md)
/test-native/*
!/test-native/README.md

# JVM crash logs
hs_err_pid*.log

# Native server executables compiled by scripts/build-llama-android.sh
/app/src/main/jniLibs/*/libllama_server.so
